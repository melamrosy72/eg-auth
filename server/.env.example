# Local development. Copy to .env (never commit .env).
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/easygen_auth

# Two different secrets, at least 32 characters each. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-generated-secret-of-32-plus-chars-1
JWT_REFRESH_SECRET=replace-with-a-different-generated-secret-of-32-plus-2

# Exact origins, comma-separated: scheme://host:port, no path, no trailing slash, no *.
FRONTEND_ORIGINS=http://localhost:5173
# FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000  # Swagger "Try it out" on :3000, dev only

# Required, no default. false only for local HTTP.
COOKIE_SECURE=false

# Number of reverse proxies in front of the server (0 locally, 1 behind Nginx in Compose).
TRUST_PROXY_HOPS=0

LOG_LEVEL=info
SWAGGER_ENABLED=true
