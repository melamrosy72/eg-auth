# Docker Compose secrets. Copy to .env (never commit .env).
# Two different secrets, at least 32 characters each. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-generated-secret-of-32-plus-chars-1
JWT_REFRESH_SECRET=replace-with-a-different-generated-secret-of-32-plus-2
